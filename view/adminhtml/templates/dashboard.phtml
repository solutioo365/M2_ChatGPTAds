<script>
require(['jquery'], function ($) {
    'use strict';
    $(function () {
        var $root = $('.scg-dash');
        if (!$root.length) {
            return;
        }

        var $store = $('#scg-store');
        var $download = $('#scg-download');
        var $messages = $('#scg-messages');
        var $preview = $('#scg-preview');

        function storeId() {
            return $store.length ? $store.val() : '1';
        }

        function showMessage(message, isError) {
            var type = isError ? 'error error' : 'success success';
            $messages.html(
                '<div class="message message-' + type + '"><div></div></div>'
            );
            $messages.find('div div').text(message);
        }

        function writePreview(data) {
            if ($preview.length) {
                $preview.val(JSON.stringify(data, null, 2));
            }
        }

        $store.on('change', function () {
            var url = $store.find('option:selected').attr('data-download');
            if (url) {
                $download.attr('href', url);
            }
        });

        $('#scg-copy-url').on('click', function () {
            var url = $store.find('option:selected').attr('data-feed-url') || '';
            if (!url) {
                showMessage('Keine Feed-URL vorhanden.', true);
                return;
            }
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(url).then(function () {
                    showMessage('Feed-URL kopiert.');
                }).catch(function () {
                    window.prompt('Feed-URL', url);
                });
            } else {
                window.prompt('Feed-URL', url);
            }
        });

        $root.on('click', '[data-action]', function (event) {
            event.preventDefault();
            var action = $(this).attr('data-action');
            var url = $root.attr('data-' + action + '-url');
            if (action === 'sync') {
                url = $root.attr('data-sync-url');
            }
            if (action === 'create') {
                url = $root.attr('data-create-url');
            }
            if (!url) {
                showMessage('Keine URL für diese Aktion.', true);
                return;
            }
            showMessage('Bitte warten …');
            $.ajax({
                url: url,
                type: 'POST',
                dataType: 'json',
                data: {
                    form_key: window.FORM_KEY || $root.attr('data-form-key'),
                    store_id: storeId()
                }
            }).done(function (data) {
                if (!data || data.success === false) {
                    showMessage((data && data.message) || 'Fehler', true);
                    return;
                }
                showMessage(data.message || 'OK');
                if (action === 'preview' || action === 'validate') {
                    writePreview(data);
                }
                if (action === 'generate' && data.errors) {
                    writePreview({
                        product_count: data.product_count,
                        variant_count: data.variant_count,
                        errors: data.errors.slice(0, 20),
                        warnings: (data.warnings || []).slice(0, 20)
                    });
                }
            }).fail(function (xhr) {
                var message = 'Fehler';
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    message = xhr.responseJSON.message;
                } else if (xhr.status) {
                    message = 'Fehler ' + xhr.status;
                }
                showMessage(message, true);
            });
        });
    });
});
</script>
