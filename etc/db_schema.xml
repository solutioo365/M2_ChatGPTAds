<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="solutioo_chatgpt_feed_log" resource="default" engine="innodb"
           comment="Solutioo ChatGPT feed run log">
        <column xsi:type="int" name="log_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="varchar" name="action" nullable="false" length="32"/>
        <column xsi:type="varchar" name="status" nullable="false" length="16"/>
        <column xsi:type="int" name="product_count" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="int" name="error_count" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="int" name="warning_count" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="varchar" name="file_path" nullable="true" length="512"/>
        <column xsi:type="text" name="message" nullable="true"/>
        <column xsi:type="mediumtext" name="details" nullable="true"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="log_id"/>
        </constraint>
        <index referenceId="SOLUTIOO_CHATGPT_FEED_LOG_STORE_CREATED" indexType="btree">
            <column name="store_id"/>
            <column name="created_at"/>
        </index>
        <index referenceId="SOLUTIOO_CHATGPT_FEED_LOG_ACTION_STATUS" indexType="btree">
            <column name="action"/>
            <column name="status"/>
        </index>
    </table>
</schema>
